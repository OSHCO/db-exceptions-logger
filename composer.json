{
    "name": "oshco/db-exceptions-logger",
    "description": "A component which is used to log exceptions to database.",
    "authors": [

    ],
    "require": {
        "php": ">=8.0",
        "webfiori/framework":"v3.0.0-Beta.29"
    },
    "keywords": [
        "framework",
        "webfiori",
        "database",
        "logger"
    ],
    "license": "MIT",
    "require-dev": {
        "phpunit/phpunit": "^10",
        "friendsofphp/php-cs-fixer": "^3.86"
    },
    "scripts":{
        "test": "vendor/bin/phpunit -c tests/phpunit.xml",
        "test10": "vendor/bin/phpunit -c tests/phpunit10.xml",
        "fix-cs": "vendor/bin/php-cs-fixer fix --config=php_cs.php.dist"
    }
}
