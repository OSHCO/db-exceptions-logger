{
    "name": "oshco/db-exceptions-logger",
    "description": "A component which is used to log exceptions to database.",
    "authors": [
        {
            "name": "Ibrahim BinAlshikh",
            "email": "i.binalshikh@oshco.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "webfiori/framework": "^3.0"
    },
    "keywords": [
        "framework",
        "webfiori",
        "database",
        "logger"
    ],
    "license": "MIT",
    "require-dev": {
        "phpunit/phpunit": "^10",
        "friendsofphp/php-cs-fixer": "^3.86"
    },
    "autoload": {
        "psr-4": {
            "Oshco\\": "Oshco/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit -c tests/phpunit.xml",
        "fix-cs": "vendor/bin/php-cs-fixer fix --config=php_cs.php.dist"
    }
}
